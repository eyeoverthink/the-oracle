modules = ["java-21", "java-graalvm22.3"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fraymus Engine"

[[workflows.workflow]]
name = "Fraymus Engine"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && gradle run 2>&1"

[nix]
channel = "stable-25_05"
packages = ["unzip", "gradle", "mesa", "glfw", "xorg.libX11", "xorg.libXcursor", "xorg.libXrandr", "xorg.libXinerama", "xorg.libXi", "libglvnd", "xvfb-run"]
